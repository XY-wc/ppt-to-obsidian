# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/
# 打包专用虚拟环境(本地)
.venv-build/

# 测试与缓存
.pytest_cache/
.python-version
*.log

# 构建产物 (PyInstaller)
build/
dist/
# PyInstaller 生成的 .spec 包含本地绝对路径, 由 build_exe.py 自动重建, 不入库
*.spec
# 分享压缩包
*.zip

# 历史构建备份(本地保留, 不进仓库)
_backup_dist_*/
_old_*.zip

# 运行时数据(用户私有, 落盘在 ~/.ppt2obsidian/, 此处为空目录占位说明)
data/
outputs/*.pptx
outputs/*.pdf
outputs/*.ppt
# 本地界面预览截图(开发自测用)
outputs/*.png

# ★ 凭据安全: 本地账号 / 模型 API Key 一律不入库(即使被误建在仓库内也不能提交)
.ppt2obsidian/
**/.ppt2obsidian/
*.key
secrets.json
.env

# 开发期截图(可能含本地用户名/路径), 公开发布前需替换或脱敏
docs/*.png
docs/*.jpg
docs/使用说明*.txt
# 本地界面预览截图(开发自测用)
_ui_*.png

# 打包临时目录
_dist_tmp/
_build_tmp/

# 桌面快捷方式/临时
*.lnk
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
