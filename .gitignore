# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# 测试与缓存
.pytest_cache/
.python-version
*.log

# 构建产物 (PyInstaller)
build/
dist/
# PyInstaller 生成的 .spec 包含本地绝对路径, 由 build_exe.py 自动重建, 不入库
*.spec
# 分享压缩包
*.zip

# 历史构建备份(本地保留, 不进仓库)
_backup_dist_*/
_old_*.zip

# 运行时数据(用户私有, 落盘在 ~/.ppt2obsidian/, 此处为空目录占位说明)
data/
outputs/*.pptx
outputs/*.pdf
outputs/*.ppt

# 开发期截图(可能含本地用户名/路径), 公开发布前需替换或脱敏
docs/*.png
docs/*.jpg
docs/使用说明*.txt

# 桌面快捷方式/临时
*.lnk
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
